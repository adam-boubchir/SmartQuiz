@using SmartQuiz.Models

@{
    ViewData["Title"] = "Messages";
    var contacts = (ViewBag.Contacts as List<SmartQuiz.Models.ContactDto>) ?? new();

}

<style>
    .chat-container {
        display: flex;
        height: 85vh;
        border: 1px solid #ccc;
        border-radius: 10px;
        overflow: hidden;
    }

    .contact-list {
        width: 30%;
        border-right: 1px solid #ccc;
        overflow-y: auto;
        background: #f7f7f7;
    }

    .contact-item {
        padding: 15px;
        cursor: pointer;
        border-bottom: 1px solid #e0e0e0;
    }

        .contact-item:hover {
            background: #e9e9e9;
        }

    .chat-window {
        width: 70%;
        display: flex;
        flex-direction: column;
    }

    .messages-box {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
    }

    .msg {
        margin: 10px 0;
        max-width: 60%;
        padding: 10px;
        border-radius: 10px;
    }

    .msg-me {
        background: #d1ffd1;
        margin-left: auto;
    }

    .msg-other {
        background: #fff;
        border: 1px solid #ccc;
    }

    .send-box {
        display: flex;
        padding: 10px;
        border-top: 1px solid #ccc;
    }

        .send-box input {
            flex: 1;
        }
</style>

<div class="chat-container">
    <!-- CONTACT LIST -->
    <div class="contact-list">
        @foreach (var c in contacts)
        {
            <div class="contact-item" onclick="openChat('@c.UserId', '@c.DisplayName')">
                <strong>@c.DisplayName</strong> (@c.Role)
            </div>
        }
    </div>

    <!-- CHAT WINDOW -->
    <div class="chat-window">
        <div id="chatWith" style="padding:10px; border-bottom:1px solid #ccc; font-weight:bold;">
            Sélectionnez un contact
        </div>

        <div id="messages" class="messages-box">
        </div>

        <div class="send-box">
            <input id="messageInput" placeholder="Écrire un message..." class="form-control" />
            <button class="btn btn-primary" onclick="sendMessage()">Envoyer</button>
        </div>
    </div>
</div>


<script>
    // ID de l'utilisateur connecté envoyé par Razor
    const myId = "@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value";

    let activeUser = null;

    function openChat(userId, username) {
        activeUser = userId;
        document.getElementById("chatWith").innerText = "Chat avec " + username;

        fetch(`/Messages/Conversation?withUserId=${userId}`)
            .then(r => r.json())
            .then(data => {
                const box = document.getElementById("messages");
                box.innerHTML = "";

                data.forEach(m => {
                    const div = document.createElement("div");
                    div.classList.add("msg");

                    // alignement des messages
                    div.classList.add(m.senderId === myId ? "msg-me" : "msg-other");

                    div.innerText = m.content;
                    box.appendChild(div);
                });

                box.scrollTop = box.scrollHeight;
            });
    }

    function sendMessage() {
        if (!activeUser) return;

        const content = document.getElementById("messageInput").value;

        fetch("/Messages/Send", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: `recipientId=${activeUser}&content=${content}`
        })
        .then(() => {
            document.getElementById("messageInput").value = "";
            openChat(activeUser, "");
        });
    }
</script>

