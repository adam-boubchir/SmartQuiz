@model List<SmartQuiz.Models.Module>

@{
    ViewData["Title"] = "Liste des Modules";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Modules</h2>
    <a class="btn btn-primary" asp-action="CreateModule">➕ Ajouter Module</a>
</div>

<table class="table table-bordered shadow-sm">
    <thead class="table-light">
        <tr>
            <th>Nom du Module</th>
            <th style="width: 200px;">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.Name</td>
                <td>
                  <a class="btn btn-sm btn-warning" asp-action="EditModule" asp-route-id="@m.Id">Modifier</a>
                  <a class="btn btn-sm btn-danger" asp-action="DeleteModule" asp-route-id="@m.Id">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>
