@model List<SmartQuiz.Models.Module>

@{
    ViewData["Title"] = "Modules";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Modules</h2>
    <a class="btn btn-primary" asp-action="CreateModule">➕ Ajouter Module</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">Aucun module enregistré.</div>
}
else
{
    @foreach (var module in Model)
    {
        <div class="card mb-3">
            <div class="card-header">
                <strong>@module.Name</strong> – @module.Filiere (Année @module.Annee)
            </div>
            <div class="card-body">
                @foreach (var subj in module.Subjects)
                {
                    <h5>@subj.SubjectName</h5>
                    <table class="table table-sm table-bordered mb-3">
                        <thead>
                            <tr>
                                <th>Groupe</th>
                                <th>Professeur</th>
                                <th>Heures</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in subj.GroupAssignments)
                            {
                                <tr>
                                    <td>@g.GroupName</td>
                                    <td>@g.TeacherName</td>
                                    <td>@g.Hours</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
}
