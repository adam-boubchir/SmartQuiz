@{
    ViewData["Title"] = "FAQ";
}

<h2 class="text-center text-primary mb-4 fade-up">Questions fréquentes</h2>

<div class="accordion" id="faq">

    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#q1">Comment créer un compte ?</button>
        </h2>
        <div id="q1" class="accordion-collapse collapse">
            <div class="accordion-body">Cliquez sur Inscription et remplissez le formulaire.</div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#q2">Combien de temps dure l'approbation ?</button>
        </h2>
        <div id="q2" class="accordion-collapse collapse">
            <div class="accordion-body">Généralement moins de 24h.</div>
        </div>
    </div>

</div>
