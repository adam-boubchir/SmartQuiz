@model SmartQuiz.Models.AdminTeachersViewModel

@{
    ViewData["Title"] = "Enseignants";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="fade-up mb-4">
    <h2 class="fw-bold">Liste des Enseignants</h2>
    <p class="text-muted">Nom et email des enseignants</p>
</div>

<!-- TABLEAU SIMPLIFIÉ -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var t in Model.Teachers)
        {
            <tr>
                <td>@t.FullName</td>
                <td>@t.Email</td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@t.Id">Détails</a>
                    <a class="btn btn-sm btn-danger" asp-action="DeleteTeacher" asp-route-id="@t.Id" onclick="return confirm('Supprimer cet enseignant ?');">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>
