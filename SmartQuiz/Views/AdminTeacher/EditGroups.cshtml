@model List<SmartQuiz.Models.Group>

@{
    ViewData["Title"] = "Modifier les groupes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="fw-bold mb-4">Modifier les groupes assignés</h2>

<form asp-action="EditGroups" method="post">
    <input type="hidden" name="id" value="@Model.FirstOrDefault()?.TeacherId" />

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Nom du groupe</th>
                <th>Filière</th>
                <th>Année</th>
                <th>Matière</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td><input type="text" name="groups[@i].Name" value="@Model[i].Name" class="form-control" /></td>
                    <td><input type="text" name="groups[@i].Filiere" value="@Model[i].Filiere" class="form-control" /></td>
                    <td><input type="number" name="groups[@i].Annee" value="@Model[i].Annee" class="form-control" /></td>
                    <td><input type="text" name="groups[@i].Subject" value="@Model[i].Subject" class="form-control" /></td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary">Sauvegarder</button>
    <a asp-action="Details" asp-route-id="@Model.FirstOrDefault()?.TeacherId" class="btn btn-secondary">Annuler</a>
</form>
