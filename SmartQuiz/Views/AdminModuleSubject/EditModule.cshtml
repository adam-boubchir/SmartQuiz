@model SmartQuiz.Models.Module

@{
    ViewData["Title"] = "Modifier Module";
}

<h2 class="fw-bold mb-3">Modifier Module</h2>

<form asp-action="EditModule" method="post">
    <input type="hidden" asp-for="Id" /> <!-- Garde l'Id pour la modification -->

    <div class="mb-3">
        <label class="form-label">Nom du Module</label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Filière</label>
        <input asp-for="Filiere" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Année</label>
        <input asp-for="Annee" class="form-control" />
    </div>

    <h4>Matière principale</h4>
    <div class="mb-3">
        <label class="form-label">Nom de la matière</label>
        <input asp-for="Subjects[0].SubjectName" class="form-control" />
    </div>

    <h5>Groupe principal</h5>
    <div class="mb-3">
        <label class="form-label">Nom du groupe</label>
        <input asp-for="Subjects[0].GroupAssignments[0].GroupName" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Enseignant</label>
        <input asp-for="Subjects[0].GroupAssignments[0].TeacherName" class="form-control" list="teachersList" autocomplete="off" />
        <datalist id="teachersList"></datalist>
    </div>
    <div class="mb-3">
        <label class="form-label">Heures</label>
        <input asp-for="Subjects[0].GroupAssignments[0].Hours" type="number" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Enregistrer</button>
    <a asp-action="ModulesAndSubjects" class="btn btn-secondary ms-2">Annuler</a>
</form>
