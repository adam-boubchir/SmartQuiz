@model SmartQuiz.Models.ModulesViewModel

@{
    ViewData["Title"] = "Modules & Matières";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="fw-bold mb-4">Modules & Matières</h2>

<!-- ==================== MODULES ==================== -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold">Modules</h3>
    <a class="btn btn-primary" asp-action="CreateModule" asp-controller="AdminModuleSubject">➕ Ajouter Module</a>
</div>

<table class="table table-bordered shadow-sm mb-5">
    <thead class="table-light">
        <tr>
            <th>Nom du Module</th>
            <th>Filière</th>
            <th>Groupe</th>
            <th>Matière</th>
            <th>Enseignant</th>
            <th>Heures groupe</th>
            <th>Total matière</th>
            <th>Total module</th>
            <th style="width: 200px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Modules != null && Model.Modules.Any())
        {
            foreach (var m in Model.Modules)
            {
                <tr>
                    <td>@m.ModuleName</td>
                    <td>@m.Filiere</td>
                    <td>@m.GroupName</td>
                    <td>@m.SubjectName</td>
                    <td>@m.TeacherName</td>
                    <td>@m.GroupHours</td>
                    <td>@m.TotalSubjectHours</td>
                    <td>@m.TotalModuleHours</td>
                    <td>
                        <a class="btn btn-sm btn-warning"
                           asp-action="EditModule"
                           asp-controller="AdminModuleSubject"
                           asp-route-id="@m.ModuleId">
                            Modifier
                        </a>
                        <a class="btn btn-sm btn-danger"
   asp-action="DeleteModuleRow"
   asp-controller="AdminModuleSubject"
   asp-route-moduleId="@m.ModuleId"
   asp-route-subjectName="@m.SubjectName"
   asp-route-groupName="@m.GroupName">
   Supprimer
</a>

                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9" class="text-center text-muted">
                    Aucun module enregistré pour le moment.
                </td>
            </tr>
        }
    </tbody>
</table>

