@model SmartQuiz.Models.Group

@{
    ViewData["Title"] = "Détails du groupe";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="fade-up mb-4">
    <h2 class="fw-bold">Détails du groupe</h2>
    <p class="text-muted">Informations complètes sur le groupe sélectionné</p>
</div>

<div class="card p-4 mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-3">Nom du groupe</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Filière</dt>
        <dd class="col-sm-9">@Model.Filiere</dd>

        <dt class="col-sm-3">Année</dt>
        <dd class="col-sm-9">
            @(Model.Annee == 1 ? "1ère année" : $"{Model.Annee}ème année")
        </dd>

        <dt class="col-sm-3">Matière</dt>
        <dd class="col-sm-9">@Model.Subject</dd>

        <dt class="col-sm-3">Nombre d'étudiants</dt>
        <dd class="col-sm-9">@((Model.StudentIds?.Count) ?? 0)</dd>

        <dt class="col-sm-3">Actif</dt>
        <dd class="col-sm-9">
            @if (Model.IsActive)
            {
                <span class="badge bg-success">Actif</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactif</span>
            }
        </dd>

        <dt class="col-sm-3">Créé le</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-3">Dernière mise à jour</dt>
        <dd class="col-sm-9">@Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>
</div>

<div class="d-flex gap-2">
    <a asp-controller="Groups"
       asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        ✏️ Modifier ce groupe
    </a>

    <form asp-controller="Groups"
          asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post"
          onsubmit="return confirm('Supprimer ce groupe ?');">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger">
            🗑️ Supprimer
        </button>
    </form>

    <a asp-controller="Admin"
       asp-action="AllGroups"
       class="btn btn-secondary ms-auto">
        ⬅️ Retour à la liste
    </a>
</div>
