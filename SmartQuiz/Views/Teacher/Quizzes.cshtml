@model IEnumerable<SmartQuiz.Models.Quiz>

@{
    ViewData["Title"] = "Mes Quizzes";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="card shadow-sm fade-up">
    <div class="card-header d-flex justify-content-between align-items-center bg-white">
        <h5 class="m-0 fw-semibold">
            <i class="fa fa-list me-2 text-primary"></i> Mes Quizzes
        </h5>
        <div>
            <a class="btn btn-primary btn-sm" href="/Teacher/CreateQuiz">
                <i class="fa fa-plus me-1"></i> Nouveau Quiz
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Titre</th>
                    <th>Type</th>
                    <th>Questions</th>
                    <th>Groupe</th>
                    <th>Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var q in Model)
                    {
                        <tr>
                            <td class="fw-medium">@q.Title</td>

                            <td>
                                @if (q.SubjectName == "Quiz IA")
                                {
                                    <span class="badge bg-primary">🤖 IA</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">📝 Manuel</span>
                                }
                            </td>

                            <td>@(q.Questions?.Count ?? 0)</td>

                            <td>
                                @(string.IsNullOrEmpty(q.GroupId) ? "Tous" : q.GroupId)
                            </td>

                            <td>@q.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>

                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary me-1"
                                   href="/Teacher/EditQuiz/@q.Id"
                                   title="Éditer">
                                    <i class="fa fa-pen"></i>
                                </a>

                                <button class="btn btn-sm btn-outline-danger"
                                        onclick="deleteQuiz('@q.Id')"
                                        title="Supprimer">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            Aucun quiz créé.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        async function deleteQuiz(id) {
            if (!confirm("⚠️ Voulez-vous vraiment supprimer ce quiz ?")) return;

            const response = await fetch("/Teacher/DeleteQuiz", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: "id=" + encodeURIComponent(id)
            });

            const result = await response.json();

            if (result.success) {
                alert("✅ Quiz supprimé");
                location.reload();
            } else {
                alert(result.message || "Erreur lors de la suppression");
            }
        }
    </script>
}



