@model SmartQuiz.Models.Quiz
@{
    ViewData["Title"] = "Modifier le Quiz";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<h2 class="mb-3">✏️ Modifier le Quiz</h2>

<form asp-action="EditQuiz" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <!-- TITRE -->
    <div class="mb-3">
        <label class="fw-bold">Titre</label>
        <input asp-for="Title" class="form-control" required />
    </div>

    <!-- QUESTIONS -->
    <h4 class="mt-4">Questions</h4>

    <div id="questionsContainer">
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            var isMcq = q.Options != null && q.Options.Count > 0;

            <div class="border p-3 mb-3 rounded">
                <input type="hidden" name="Questions[@i].CorrectIndex" value="@q.CorrectIndex" />

                <label>Question</label>
                <input class="form-control mb-2"
                       name="Questions[@i].Text"
                       value="@q.Text" />

                <label>Type</label>
                <select class="form-select mb-2"
                        onchange="toggleType(this, @i)">
                    <option value="mcq" selected="@isMcq">Choix multiple</option>
                    <option value="text" selected="@(!isMcq)">Texte</option>
                </select>

                <!-- QCM -->
                <div class="mcq" style="display:@(isMcq ? "block" : "none")">
                    @for (int j = 0; j < q.Options.Count; j++)
                    {
                        <input class="form-control mb-1"
                               name="Questions[@i].Options[@j]"
                               value="@q.Options[j]" />
                    }
                    <label>Bonne réponse (index)</label>
                    <input type="number"
                           class="form-control"
                           name="Questions[@i].CorrectIndex"
                           value="@q.CorrectIndex" />
                </div>

                <!-- TEXTE -->
                <div class="textAnswer" style="display:@(!isMcq ? "block" : "none")">
                    <label>Réponse attendue</label>
                    <input class="form-control"
                           name="Questions[@i].Options[0]"
                           value="@(q.Options.FirstOrDefault())" />
                </div>
            </div>
        }
    </div>

    <!-- CONFIGURATION -->
    <h4 class="mt-4">Configuration</h4>

    <div class="mb-3">
        <label>Groupe cible</label>
        <select asp-for="GroupId" class="form-select">
            <option value="">Tous les groupes</option>
            @foreach (var g in ViewBag.Groups)
            {
                <option value="@g.Id">@g.Name</option>
            }
        </select>
    </div>

    <div class="row">
        <div class="col-md-6">
            <label>Ouverture</label>
            <input asp-for="StartDate" type="datetime-local" class="form-control" />
        </div>
        <div class="col-md-6">
            <label>Fermeture</label>
            <input asp-for="EndDate" type="datetime-local" class="form-control" />
        </div>
    </div>

    <button class="btn btn-success w-100 mt-4">💾 Enregistrer</button>
</form>

@section Scripts {
    <script>
        function toggleType(select, index) {
            const container = select.closest(".border");
            container.querySelector(".mcq").style.display =
                select.value === "mcq" ? "block" : "none";
            container.querySelector(".textAnswer").style.display =
                select.value === "text" ? "block" : "none";
        }
    </script>
}
