@model SmartQuiz.Models.TeacherResultsDashboardViewModel

@{
    ViewData["Title"] = "Statistiques des Résultats";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<h2 class="mb-4">📊 Tableau de bord des résultats</h2>

<div class="row text-center mb-4">
    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Étudiants évalués</h5>
            <h2>@Model.TotalEvaluatedStudents</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Moyenne Quiz</h5>
            <h2>@Model.AverageQuiz.ToString("0.0")</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Moyenne Contrôle</h5>
            <h2>@Model.AverageTest.ToString("0.0")</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Progression Moyenne</h5>
            <h2>@Model.AverageProgress.ToString("0.0")%</h2>
        </div>
    </div>
</div>

<h4 class="mt-5">📘 Statistiques par matière</h4>

<table class="table table-bordered mt-3">
    <thead class="table-dark">
        <tr>
            <th>Matière</th>
            <th>Moyenne Quiz</th>
            <th>Moyenne Contrôle</th>
            <th>Progression</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var g in Model.GroupStats)
        {
            <tr>
                <td>@g.Subject</td>
                <td>@g.AverageQuiz.ToString("0.0")</td>
                <td>@g.AverageTest.ToString("0.0")</td>
                <td>@g.AverageProgress.ToString("0.0")%</td>
            </tr>
        }
    </tbody>
</table>

<h4 class="mt-5">🏆 Top 5 des meilleurs étudiants</h4>

<table class="table table-striped mt-3">
    <thead class="table-dark">
        <tr>
            <th>ID Étudiant</th>
            <th>Moyenne générale</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model.TopStudents)
        {
            <tr>
                <td>@student.StudentId</td>
                <td>@student.Average.ToString("0.0")</td>
            </tr>
        }
    </tbody>
</table>

<h4 class="mt-5">📈 Graphique des moyennes</h4>
<canvas id="statsChart"></canvas>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const ctx = document.getElementById('statsChart');

    const chart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: ['Quiz', 'Contrôle', 'Progression'],
            datasets: [{
                label: 'Moyennes',
                data: [
                    @Model.AverageQuiz,
                    @Model.AverageTest,
                    @Model.AverageProgress
                ],
                backgroundColor: ['#4e73df', '#1cc88a', '#36b9cc']
            }]
        }
    });
</script>
