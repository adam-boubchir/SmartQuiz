@model IEnumerable<YourProject.Models.Group>
@{
    ViewData["Title"] = "Groupes";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="card">
    <div class="card-header d-flex justify-content-between">
        <strong>Groupes</strong>
        <a class="btn btn-sm btn-primary" href="/Teacher/CreateGroup"><i class="fa fa-plus"></i> Nouveau Groupe</a>
    </div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead class="table-light"><tr><th>Nom</th><th>Étudiants</th><th></th></tr></thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var g in Model)
                    {
                        <tr>
                            <td>@g.Name</td>
                            <td>@(g.StudentIds?.Count ?? 0)</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" href="/Teacher/EditGroup/@g.Id"><i class="fa fa-pen"></i></a>
                                <a class="btn btn-sm btn-outline-danger" href="/Teacher/DeleteGroup/@g.Id"><i class="fa fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="3">Aucun groupe défini.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
