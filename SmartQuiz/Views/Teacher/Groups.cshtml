@model IEnumerable<SmartQuiz.Models.Group>

@{
    ViewData["Title"] = "Groupes";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center bg-white">
        <h5 class="m-0 fw-semibold"><i class="fa fa-users me-2 text-primary"></i>Groupes</h5>
        <a class="btn btn-primary btn-sm" href="/Teacher/CreateGroup">
            <i class="fa fa-plus me-1"></i> Nouveau Groupe
        </a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nom</th>
                    <th>Étudiants</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var g in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@g.Name</td>
                            <td>
                                <span class="badge bg-primary bg-opacity-75">
                                    @(g.StudentIds?.Count ?? 0)
                                </span>
                            </td>

                            <td class="text-end">
                                <a class="btn btn-outline-primary btn-sm" href="/Teacher/EditGroup/@g.Id">
                                    <i class="fa fa-pen"></i>
                                </a>

                                <a class="btn btn-outline-danger btn-sm" href="/Teacher/DeleteGroup/@g.Id">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">
                            Aucun groupe défini.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
