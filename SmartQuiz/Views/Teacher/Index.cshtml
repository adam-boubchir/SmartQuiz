@{
    ViewData["Title"] = "Tableau de bord";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="row g-3 fade-up">
    <div class="col-6 col-md-3">
        <div class="card-stat p-3">
            <small class="text-muted">Total Quizzes</small>
            <h3 class="mt-2">@ViewBag.TotalQuizzes</h3>
            <div class="mt-2"><span class="badge bg-primary bg-opacity-10 text-primary">Voir</span></div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card-stat p-3">
            <small class="text-muted">Total TPs</small>
            <h3 class="mt-2">@ViewBag.TotalTps</h3>
            <div class="mt-2"><span class="badge bg-primary bg-opacity-10 text-primary">Gérer</span></div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card-stat p-3">
            <small class="text-muted">Groupes</small>
            <h3 class="mt-2">@ViewBag.TotalGroups</h3>
            <div class="mt-2"><span class="badge bg-primary bg-opacity-10 text-primary">Groupes</span></div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card-stat p-3">
            <small class="text-muted">Étudiants</small>
            <h3 class="mt-2">@ViewBag.TotalStudents</h3>
            <div class="mt-2"><span class="badge bg-primary bg-opacity-10 text-primary">Suivi</span></div>
        </div>
    </div>
</div>

<div class="row mt-4 g-3">
    <div class="col-md-6 fade-up">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Derniers Quizzes</strong>
                <a href="/Teacher/Quizzes" class="small text-decoration-none">Voir tout</a>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr><th>Titre</th><th>Groupe</th><th>Date</th></tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.RecentQuizzes != null)
                        {
                            foreach (var q in ViewBag.RecentQuizzes)
                            {
                                <tr>
                                    <td class="fw-medium">@q.Title</td>
                                    <td>@(q.GroupId ?? "-")</td>
                                    <td>@(q.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd"))</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center text-muted">Aucun quiz trouvé.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6 fade-up">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Derniers TPs</strong>
                <a href="/Teacher/Tps" class="small text-decoration-none">Voir tout</a>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="table-light"><tr><th>TP</th><th>Deadline</th></tr></thead>
                    <tbody>
                        @if (ViewBag.RecentTps != null)
                        {
                            foreach (var tp in ViewBag.RecentTps)
                            {
                                <tr>
                                    <td class="fw-medium">@tp.Title</td>
                                    <td>@(tp.Deadline.ToLocalTime().ToString("yyyy-MM-dd"))</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="2" class="text-center text-muted">Aucun TP trouvé.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
