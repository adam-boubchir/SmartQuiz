@model List<SmartQuiz.Models.Result>

@{
    ViewData["Title"] = "Détails des résultats";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<h2 class="mt-3 mb-4 text-center">📊 Détails des résultats</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning text-center">
        Aucun résultat trouvé pour cet étudiant.
    </div>
}
else
{
    var studentName = Model.First().SubjectName == null
        ? "Étudiant"
        : Model.First().SubjectName;
}

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Matière</th>
            <th>Note Quiz</th>
            <th>Note Contrôle</th>
            <th>Avancement</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var result in Model)
        {
            <tr>
                <td>@result.SubjectName</td>
                <td>@result.QuizScore</td>
                <td>@result.TestScore</td>
                <td>@result.Progression %</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="StudentsResults" class="btn btn-secondary">⬅️ Retour</a>
</div>
