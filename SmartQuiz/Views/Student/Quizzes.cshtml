@model IEnumerable<SmartQuiz.Models.Quiz>
@{
    ViewData["Title"] = "Tous les Quizzes";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<h3>📚 Tous les Quizzes</h3>

<table class="table table-bordered mt-3">
    <thead class="table-light">
        <tr>
            <th>Titre</th>
            <th>type</th>
            <th>Description</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var quiz in Model)
        {
            <tr>
                <td>@quiz.Title</td>
                <td>
                    @(quiz.SubjectName == "Quiz IA" ? "🤖 IA" : "✍️ Manuel")
                </td>
                <td>@quiz.Description</td>
                <td>
                    @if (quiz.StartDate == null || quiz.EndDate == null)
                    {
                        <span class="badge bg-secondary">❓ Non configuré</span>
                    }
                    else if (DateTime.UtcNow < quiz.StartDate)
                    {
                        <span class="badge bg-warning">⏳ En attente</span>
                    }
                    else if (DateTime.UtcNow > quiz.EndDate)
                    {
                        <span class="badge bg-dark">🔒 Fermé</span>
                    }
                    else
                    {
                        <a href="/Student/QuizDetail/@quiz.Id"
                           class="btn btn-primary btn-sm">
                            ▶️ Commencer
                        </a>
                    }

                </td>
            </tr>
        }
    </tbody>
</table>
