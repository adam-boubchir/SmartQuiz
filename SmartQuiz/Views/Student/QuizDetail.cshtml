@model SmartQuiz.Models.Quiz

@{
    ViewData["Title"] = "Passer le Quiz";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<h3 class="mb-4">@Model.Title</h3>

@if (Model.Status != "open")
{
    <div class="alert alert-warning">
        ⛔ Ce quiz n’est pas disponible actuellement.
    </div>
}
else
{
    <form method="post" asp-action="SubmitQuiz">

        <!-- ID du quiz -->
        <input type="hidden" name="QuizId" value="@Model.Id" />

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];

            <div class="card mb-4 shadow-sm">
                <div class="card-body">

                    <h5 class="mb-3">
                        Question @(i + 1)
                    </h5>

                    <p class="fw-semibold">@q.Text</p>

                    <!-- ===================== QCM ===================== -->
                    @if (q.Options != null && q.Options.Any())
                    {
                        for (int j = 0; j < q.Options.Count; j++)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="radio"
                                       name="Answers[@i]"
                                       value="@q.Options[j]"
                                       required />

                                <label class="form-check-label">
                                    @q.Options[j]
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- ================= QUESTION TEXTE ================= -->
                        <input type="text"
                               name="Answers[@i]"
                               class="form-control"
                               placeholder="Votre réponse..."
                               required />
                    }

                </div>
            </div>
        }

        <button type="submit" class="btn btn-primary w-100 py-2">
            ✅ Soumettre mes réponses
        </button>

    </form>
}
