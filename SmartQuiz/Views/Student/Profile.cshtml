@model SmartQuiz.Models.StudentProfileViewModel
@{
    ViewData["Title"] = "Profil étudiant";
    Layout = "~/Views/Student/_Layout.cshtml";
}

<div class="container-fluid fade-up">
    <div class="row">
        <div class="col-12 mb-3">
            <h3 class="fw-bold">Mon Profil</h3>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card p-4 shadow-sm">
                <div class="d-flex flex-column align-items-center">
                    <img src="@(Model.AvatarPath ?? "/images/default-avatar.png")" class="rounded-circle mb-3" style="width:120px;height:120px;object-fit:cover;border:6px solid #f3f5f7;">
                    <h5 class="mb-0">@Model.Username</h5>
                    <small class="text-muted">@Model.Email</small>

                    <form asp-action="UploadAvatar" method="post" enctype="multipart/form-data" class="mt-3 w-100">
                        <input type="file" name="avatar" accept="image/*" class="form-control form-control-sm mb-2" />
                        <button class="btn btn-sm btn-primary w-100">Télécharger</button>
                    </form>
                </div>
            </div>

            <div class="card p-4 mt-3 shadow-sm">
                <h6 class="fw-bold">Statistiques</h6>
                <div class="d-flex justify-content-between mt-3">
                    <div>
                        <small class="text-muted">Quizzes</small>
                        <div class="h4">@Model.TotalQuizzes</div>
                    </div>
                    <div>
                        <small class="text-muted">TPs</small>
                        <div class="h4">@Model.TotalTps</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card p-4 shadow-sm mb-3">
                <h5 class="fw-bold mb-3">Informations personnelles</h5>

                <form asp-action="ProfileUpdate" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nom complet</label>
                            <input class="form-control" name="Username" value="@Model.Username" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input class="form-control" name="Email" value="@Model.Email" />
                        </div>
                    </div>

                    <div class="mt-3">
                        <button class="btn btn-primary">Enregistrer</button>
                    </div>
                </form>
            </div>

            <div class="card p-4 shadow-sm mb-3">
                <h5 class="fw-bold mb-3">Modifier le mot de passe</h5>

                <form asp-action="ChangePassword" method="post">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label">Ancien mot de passe</label>
                            <input class="form-control" name="OldPassword" type="password" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Nouveau mot de passe</label>
                            <input class="form-control" name="NewPassword" type="password" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Confirmer</label>
                            <input class="form-control" name="ConfirmNewPassword" type="password" required />
                        </div>
                    </div>

                    <div class="mt-3">
                        <button class="btn btn-outline-primary">Changer le mot de passe</button>
                    </div>
                </form>
            </div>

            <div class="card p-4 shadow-sm">
                <h5 class="fw-bold mb-3">Mes professeurs</h5>
                <table class="table">
                    <thead>
                        <tr><th>Nom</th><th>Email</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Teachers != null && Model.Teachers.Any())
                        {
                            foreach (var t in Model.Teachers)
                            {
                                <tr>
                                    <td>@t.Name</td>
                                    <td>@t.Email</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="2" class="text-center text-muted">Aucun professeur assigné.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
