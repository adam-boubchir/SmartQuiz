@model SmartQuiz.Models.AdminDashboardViewModel

<div class="mb-8">
    <h2 class="text-4xl font-bold text-gray-800">Tableau de bord Administrateur</h2>
    <p class="text-gray-500 mt-1">Bienvenue sur l’espace d’administration</p>
</div>

<!-- GRID DES STATS -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    <!-- CARD -->
    <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-xl transition">
        <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-700">Total Utilisateurs</h3>
            <div class="p-3 rounded-xl bg-blue-100">
                <i class="fa-solid fa-users text-blue-600 text-xl"></i>
            </div>
        </div>
        <p class="mt-3 text-4xl font-bold text-blue-600">@Model.TotalUsers</p>
    </div>

    <!-- CARD -->
    <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-xl transition">
        <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-700">Enseignants</h3>
            <div class="p-3 rounded-xl bg-green-100">
                <i class="fa-solid fa-chalkboard-user text-green-600 text-xl"></i>
            </div>
        </div>
        <p class="mt-3 text-4xl font-bold text-green-600">@Model.Teachers</p>
    </div>

    <!-- CARD -->
    <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-xl transition">
        <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-700">Étudiants</h3>
            <div class="p-3 rounded-xl bg-purple-100">
                <i class="fa-solid fa-user-graduate text-purple-600 text-xl"></i>
            </div>
        </div>
        <p class="mt-3 text-4xl font-bold text-purple-600">@Model.Students</p>
    </div>

</div>

<!-- Comptes en attente -->
<div class="mt-10 bg-white rounded-2xl shadow-lg p-8 border border-gray-100 hover:shadow-xl transition">

    <div class="flex items-center justify-between">
        <h3 class="text-2xl font-semibold text-gray-700">Comptes en attente de validation</h3>
        <div class="p-3 rounded-xl bg-orange-100">
            <i class="fa-solid fa-clock text-orange-600 text-xl"></i>
        </div>
    </div>

    <p class="text-5xl mt-4 font-bold text-orange-500">@Model.Pending</p>

    <a href="/Admin/PendingUsers"
      class="inline-block mt-6 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-semibold transition">
      ⚙️ Gérer les utilisateurs en attente
    </a>

</div>

<!-- Import font awesome si non présent -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
