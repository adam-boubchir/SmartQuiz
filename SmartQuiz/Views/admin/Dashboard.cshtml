@model SmartQuiz.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Admin";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="fade-up mb-4">
    <h2 class="fw-bold text-dark">Dashboard Administrateur</h2>
    <p class="text-muted">Aperçu global de la plateforme SmartQuiz</p>
</div>

<div class="row g-3 fade-up">

    <!-- TOTAL UTILISATEURS -->
    <div class="col-6 col-md-3">
        <a asp-controller="Admin" asp-action="Users" class="text-decoration-none">
            <div class="card-stat p-3">
                <small class="text-muted">Total Utilisateurs</small>
                <h3 class="mt-2">@Model.TotalUsers</h3>
                <div class="mt-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary">Voir</span>
                </div>
            </div>
        </a>
    </div>

    <!-- ENSEIGNANTS -->
    <div class="col-6 col-md-3">
        <a asp-controller="Admin" asp-action="Teachers" class="text-decoration-none">
            <div class="card-stat p-3">
                <small class="text-muted">Enseignants</small>
                <h3 class="mt-2">@Model.Teachers</h3>
                <div class="mt-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary">Détails</span>
                </div>
            </div>
        </a>
    </div>

    <!-- ÉTUDIANTS -->
    <div class="col-6 col-md-3">
        <a asp-controller="Admin" asp-action="Students" class="text-decoration-none">
            <div class="card-stat p-3">
                <small class="text-muted">Étudiants</small>
                <h3 class="mt-2">@Model.Students</h3>
                <div class="mt-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary">Suivi</span>
                </div>
            </div>
        </a>
    </div>

    <!-- EN ATTENTE -->
    <div class="col-6 col-md-3">
        <a asp-controller="Admin" asp-action="PendingUsers" class="text-decoration-none">
            <div class="card-stat p-3">
                <small class="text-muted">En Attente</small>
                <h3 class="mt-2 text-warning">@Model.Pending</h3>
                <div class="mt-2">
                    <span class="badge bg-warning bg-opacity-10 text-warning">Gérer</span>
                </div>
            </div>
        </a>
    </div>

</div>


<div class="fade-up mt-4">
    <a href="/Admin/Users" class="btn btn-primary rounded-pill px-4">
        Gérer tous les utilisateurs
    </a>
</div>
