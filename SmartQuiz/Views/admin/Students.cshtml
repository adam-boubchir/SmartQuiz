@model SmartQuiz.Models.AdminStudentsViewModel
@{
    ViewData["Title"] = "Étudiants";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="fade-up mb-4">
    <h2 class="fw-bold">Gestion des Étudiants</h2>
    <p class="text-muted">Aperçu global et gestion détaillée</p>
</div>

<!-- 🎯 STATISTIQUES AVANCÉES -->
<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="card-stat p-3">
            <small class="text-muted">Total Étudiants</small>
            <h3>
                <a asp-action="Students" asp-controller="Admin" class="text-decoration-none text-dark">
                    @Model.TotalStudents
                </a>
            </h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card-stat p-3">
            <small class="text-muted">Groupes</small>
            <h3>
                <a asp-action="AllGroups" asp-controller="Admin" class="text-decoration-none text-dark">
                    @Model.TotalGroups
                </a>
            </h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card-stat p-3">
            <small class="text-muted">Étudiants sans groupe</small>
            <h3>
                <a asp-action="StudentsWithoutGroup" asp-controller="Admin" class="text-decoration-none text-danger">
                    @Model.StudentsWithoutGroup
                </a>
            </h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card-stat p-3">
            <small class="text-muted">Moyenne Étudiants / Groupe</small>
            <h3>
                <a asp-action="AveragePerGroup" asp-controller="Admin" class="text-decoration-none text-dark">
                    @Model.AverageStudentsPerGroup
                </a>
            </h3>
        </div>
    </div>

</div>


<!-- 🎓 LISTE DES ÉTUDIANTS -->
<div class="card p-3 fade-up">
    <h5 class="mb-3">Liste des étudiants</h5>

    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Nom</th>
                <th>Email</th>
                <th>Groupe</th>
                <th style="width:140px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model.Students)
            {
                <tr>
                    <td>@student.FullName</td>
                    <td>@student.Email</td>
                    <td>@student.GroupName</td>

                    <td>
                        <button class="btn btn-sm btn-primary">Modifier</button>
                        <button class="btn btn-sm btn-danger">Supprimer</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
