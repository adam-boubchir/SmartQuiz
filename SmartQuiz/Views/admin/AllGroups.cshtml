@model SmartQuiz.Models.AdminGroupsViewModel

@{
    ViewData["Title"] = "Groupes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="fade-up mb-4">
    <h2 class="fw-bold">Gestion des Groupes</h2>
    <p class="text-muted">Filtre par filière et année, puis visualise les groupes</p>
</div>

<div class="mb-3 d-flex justify-content-end">
    <a asp-action="AddGroup" asp-controller="Admin" class="btn btn-success">
        ➕ Ajouter un groupe
    </a>
</div>

<!-- 🔍 FILTRES -->
<div class="card p-3 mb-4">
    <form asp-action="AllGroups" asp-controller="Admin" method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Filière</label>
            <select name="filiere" class="form-select">
                <option value="">-- Toutes les filières --</option>
                @foreach (var f in Model.Filieres)
                {
                    <option value="@f" selected="@(Model.SelectedFiliere == f ? "selected" : null)">
                    @f
                    </option>

                }
            </select>
        </div>

        <div class="col-md-4">
    <label class="form-label">Année</label>
    <select name="annee" class="form-select">
    <option value="">-- Toutes les années --</option>
    @foreach (var a in Model.Annees)
    {
        var suffix = a == 1 ? "ère" : "ème";

        if (Model.SelectedAnnee.HasValue && Model.SelectedAnnee.Value == a)
        {
            @:<option value="@a" selected>@a @suffix année</option>
        }
        else
        {
            @:<option value="@a">@a @suffix année</option>
        }
    }
</select>

</div>


        <div class="col-md-4">
            <button type="submit" class="btn btn-primary">
                Appliquer les filtres
            </button>
        </div>
    </form>
</div>

<!-- 📋 LISTE DES GROUPES -->
<div class="card p-3 fade-up">
    <h5 class="mb-3">Liste des groupes</h5>

    @if (Model.Groups == null || !Model.Groups.Any())
    {
        <p class="text-muted">Aucun groupe trouvé pour ces critères.</p>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nom du groupe</th>
                    <th>Filière</th>
                    <th>Année</th>
                    <th>Matière</th>
                    <th>Nombre d'étudiants</th>
                    <th style="width:140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model.Groups)
                {
                    <tr>
                        <td>@g.Nom</td>
                        <td>@g.Filiere</td>
                        <td>@g.AnneeFormatee</td>
                        <td>@g.Subject</td>
                        <td>@g.NombreEtudiants</td>
                        <td>
                            <a asp-action="GroupDetails" asp-route-id="@g.Id" class="btn btn-sm btn-outline-primary">
                                Détails
                            </a>
                            <a asp-action="EditGroup" asp-route-id="@g.Id" class="btn btn-sm btn-primary">
                                Modifier
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
