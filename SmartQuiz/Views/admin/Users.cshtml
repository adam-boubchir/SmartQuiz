@model List<SmartQuiz.Models.User>
@{
    ViewData["Title"] = "Gestion des utilisateurs";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="fw-bold text-dark fade-up mb-4">Gestion des utilisateurs</h2>

<div class="card shadow-sm fade-up">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead class="table-light">
                <tr>
                    <th>Email</th>
                    <th>Nom d'utilisateur</th>
                    <th>Rôle</th>
                    <th>Statut</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td class="fw-medium">@user.Username</td>
                        <td>@user.Role</td>

                        <td>
                            @if (user.IsApproved)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success">Activé</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger">En attente</span>
                            }
                        </td>

                        <td class="text-center">
                            @if (!user.IsApproved)
                            {
                                <a href="/Admin/Accept/@user.Id.ToString()"
                                   class="badge bg-success bg-opacity-10 text-success px-3 py-2 text-decoration-none">
                                    Accepter
                                </a>
                            }

                            <a href="/Admin/Delete/@user.Id.ToString()"
                               onclick="return confirm('Supprimer cet utilisateur ?');"
                               class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 text-decoration-none ms-2">
                                Supprimer
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>
