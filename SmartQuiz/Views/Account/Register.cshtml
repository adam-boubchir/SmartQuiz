@{
    ViewBag.Title = "Inscription";
}

<div class="register-container fade-up show">

    <h2 class="title">Créer un compte</h2>

    <form method="post" class="register-form">

        <!-- Email -->
        <div class="form-group">
            <label>Email :</label>
            <input type="email" name="email" required class="form-control" />
        </div>

        <!-- Username -->
        <div class="form-group">
            <label>Nom d’utilisateur :</label>
            <input type="text" name="username" required class="form-control" />
        </div>

        <!-- Password -->
        <div class="form-group">
            <label>Mot de passe :</label>
            <input type="password" name="password" required class="form-control" />
        </div>

        <!-- Role -->
        <div class="form-group">
            <label>Rôle :</label>
            <select name="role" class="form-control" required>
                <option value="Student">Étudiant</option>
                <option value="Teacher">Professeur</option>
                <option value="Admin">Admin</option>
            </select>
        </div>

        <!-- Submit -->
        <button type="submit" class="btn btn-primary w-100 mt-3">Créer mon compte</button>

        <!-- Error message -->
        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {
            <p class="text-danger mt-3">@ViewBag.Error</p>
        }
    </form>

    <div class="mt-3 text-center">
        <a href="/Account/Login">Déjà inscrit ? Se connecter</a>
    </div>
</div>

<!-- Styles -->
<style>
    .register-container {
        max-width: 480px;
        margin: 40px auto;
        padding: 32px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.08);
    }

    .register-form .form-group {
        margin-bottom: 20px;
    }

    .title {
        text-align: center;
        font-weight: 800;
        margin-bottom: 30px;
        color: #0d47a1;
    }
</style>
