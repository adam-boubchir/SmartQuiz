@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SmartQuiz</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css" />

    <!-- Style réutilisé du teacher -->
    <link rel="stylesheet" href="~/css/teacher.css" />

    <style>
        .page-title {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 60vw;
            display: inline-block;
        }

        .fade-up {
            transform: translateY(6px);
            opacity: 0;
            transition: all .35s ease;
        }

            .fade-up.show {
                transform: translateY(0);
                opacity: 1;
            }

       
    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <div class="sidebar">
        <div class="brand d-flex align-items-center">
            <i class="fa-solid fa-graduation-cap fa-2x me-2"></i>
            <div>
                <div class="fw-bold">SmartQuiz</div>
                <small style="opacity:0.9">Student Panel</small>
            </div>
        </div>

        <nav class="mt-3">
            <a class="d-flex align-items-center @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
               href="/Student/Index">
                <i class="fa fa-home me-3"></i>
                <span class="nav-label">Dashboard</span>
            </a>

            <a class="d-flex align-items-center @(ViewContext.RouteData.Values["action"]?.ToString() == "Quizzes" ? "active" : "")"
               href="/Student/Quizzes">
                <i class="fa fa-list me-3"></i>
                <span class="nav-label">Quizzes</span>
            </a>

            <a class="d-flex align-items-center @(ViewContext.RouteData.Values["action"]?.ToString() == "Tps" ? "active" : "")"
               href="/Student/Tps">
                <i class="fa fa-file-lines me-3"></i>
                <span class="nav-label">TPs</span>
            </a>

            <a class="d-flex align-items-center @(ViewContext.RouteData.Values["action"]?.ToString() == "MyResults" ? "active" : "")"
               href="/Student/MyResults">
                <i class="fa fa-chart-line me-3"></i>
                <span class="nav-label">Mes Résultats</span>
            </a>

            <li class="nav-item">
                <a class="nav-link" href="/Messages">
                    <i class="fa fa-comments"></i> Messages
                    <span id="unreadBadge" class="badge bg-danger" style="display:none;">0</span>
                </a>
            </li>
            @await Html.PartialAsync("_ChatbotMenuButton")



            <hr style="border-color: rgba(255,255,255,0.06);" />

            <a class="d-flex align-items-center @(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")"
               href="/Student/Profile">
                <i class="fa fa-user me-3"></i>
                <span class="nav-label">Profil</span>
            </a>

            <a class="d-flex align-items-center" href="/Account/Logout">
                <i class="fa fa-right-from-bracket me-3"></i>
                <span class="nav-label">Déconnexion</span>
            </a>
        </nav>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main">
        <div class="topbar d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <h4 class="m-0 page-title">@ViewData["Title"]</h4>
            </div>

            <div class="d-flex align-items-center gap-2 toolbar">

                <!-- 🔥 Zone profil corrigée -->
                <div class="dropdown">
                    <a class="d-flex align-items-center gap-2 text-dark text-decoration-none" href="#" data-bs-toggle="dropdown">

                        <!-- Photo de profil -->
                        <img src="@((User.FindFirst("ProfileImage")?.Value) ?? "/images/default_profile.png")"
                             class="rounded-circle"
                             style="width:40px; height:40px; object-fit:cover; border:2px solid #ddd;" />

                        <div class="d-none d-md-block text-end">
                            <div class="fw-semibold">@User.Identity?.Name</div>
                            <small class="text-muted">Student</small>
                        </div>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/Student/Profile">Profil</a></li>
                        <li><a class="dropdown-item" href="/Account/Logout">Déconnexion</a></li>
                    </ul>
                </div>
                <!-- 🔥 Fin zone profil -->
            </div>
        </div>

        <!-- PAGE CONTENT -->
        <main class="mt-3">
            @RenderBody()
        </main>

        <footer class="mt-5 text-center text-muted">
            <small>© @DateTime.UtcNow.Year SmartQuiz — Plateforme d'enseignement</small>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.fade-up').forEach((el, i) => {
                setTimeout(() => el.classList.add('show'), 80 * i);
            });
        });
    </script>
    <script src="~/js/site.js"></script>
    <script src="~/js/chatbot-page.js"></script>
    @await Html.PartialAsync("_Chatbot")
</body>
</html>
