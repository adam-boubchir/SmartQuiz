@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SmartQuiz Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <!-- Bootstrap & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css" />

    <!-- Reuse teacher CSS but override colors later -->
    <link rel="stylesheet" href="~/css/teacher.css" />

    <style>
        .brand small {
            opacity: .9;
        }

        .sidebar {
            width: 240px;
            background: #0d47a1;
        }

            .sidebar .nav-label {
                color: white;
            }

            .sidebar a {
                color: #e3e3e3;
            }

                .sidebar a.active {
                    background: rgba(255,255,255,0.15);
                    color: #fff;
                }

        .avatar {
            width: 38px;
            height: 38px;
            background: #1565c0;
            border-radius: 50%;
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <div class="brand d-flex align-items-center">
            <i class="fa-solid fa-shield-halved fa-2x me-2"></i>
            <div>
                <div class="fw-bold text-white">SmartQuiz</div>
                <small class="text-light">Admin Panel</small>
            </div>
        </div>

        <nav class="mt-3">

            <a class="d-flex align-items-center @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" href="/Admin/Dashboard">
                <i class="fa fa-home me-3"></i><span class="nav-label">Dashboard</span>
            </a>

            <a class="d-flex align-items-center @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")" href="/Admin/Users">
                <i class="fa fa-users me-3"></i><span class="nav-label">Utilisateurs</span>
            </a>

            <a class="d-flex align-items-center @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminTeacher" ? "active" : "")" href="/AdminTeacher">
                <i class="fa fa-chalkboard-user me-3"></i>
                <span class="nav-label">Enseignants</span>
            </a>

            <a class="d-flex align-items-center @(ViewContext.RouteData.Values["action"]?.ToString() == "Students" ? "active" : "")" href="/Admin/Students">
                <i class="fa fa-user-graduate me-3"></i><span class="nav-label">Étudiants</span>
            </a>

            <a class="d-flex align-items-center @(ViewContext.RouteData.Values["action"]?.ToString() == "Modules" ? "active" : "")" 
                href="/Admin/Modules">
                <i class="fa fa-book me-3"></i>
                <span class="nav-label">Modules</span>
            </a>


            <a class="d-flex align-items-center @(ViewContext.RouteData.Values["action"]?.ToString() == "AllGroups" ? "active" : "")" href="/Admin/AllGroups">
                <i class="fa fa-book me-3"></i><span class="nav-label">Groups</span>
            </a>

            <a class="d-flex align-items-center @(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")" href="/AdminProfile/Settings">
                <i class="fa fa-gear me-3"></i><span class="nav-label">Paramètres</span>
            </a>

            <hr style="border-color: rgba(255,255,255,0.25);" />

            <a class="d-flex align-items-center" href="/Admin/Profile">
                <i class="fa fa-user me-3"></i><span class="nav-label">Profil</span>
            </a>

            <a class="d-flex align-items-center" href="/Account/Logout">
                <i class="fa fa-right-from-bracket me-3"></i><span class="nav-label">Déconnexion</span>
            </a>

        </nav>
    </div>

    <div class="main">
        <div class="topbar d-flex align-items-center justify-content-between">

            <h4 class="m-0 page-title">@ViewData["Title"]</h4>

            <div class="d-flex align-items-center gap-2 toolbar">

                <div class="dropdown">
                    <a class="d-flex align-items-center gap-2 text-dark text-decoration-none" href="#" data-bs-toggle="dropdown">
                        <div class="avatar"></div>
                        <div class="d-none d-md-block text-end">
                            <div class="fw-semibold">@User.Identity?.Name</div>
                            <small class="text-muted">Admin</small>
                        </div>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/Account/Profile">Profil</a></li>
                        <li><a class="dropdown-item" href="/Account/Logout">Déconnexion</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <main class="mt-3">
            @RenderBody()
        </main>

        <footer class="mt-5 text-center text-muted">
            <small>© @DateTime.UtcNow.Year SmartQuiz — Administration</small>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.fade-up').forEach((el, i) => {
                setTimeout(() => el.classList.add('show'), 80 * i);
            });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
