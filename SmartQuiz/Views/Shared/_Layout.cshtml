@using System.Security.Claims
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SmartQuiz</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap + FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css" />

    <style>
        body {
            background: #f5f7fa;
        }

        /* ----------------- TOP PUBLIC NAV ----------------- */

        .top-horizontal {
            background: #fff;
            border-bottom: 1px solid #e5eaf1;
            position: sticky;
            top: 0;
            z-index: 50;
        }

            .top-horizontal .nav-link {
                color: #334155;
                font-weight: 600;
                padding: 8px 14px;
            }

                .top-horizontal .nav-link.active {
                    color: #0d47a1;
                }

            .top-horizontal .btn {
                border-radius: 10px;
            }

        /* Public main container */
        .public-main {
            max-width: 1200px;
            margin: auto;
            padding: 32px 20px;
        }

        /* Animation */
        .fade-up {
            opacity: 0;
            transform: translateY(10px);
            transition: .5s ease;
        }

            .fade-up.show {
                opacity: 1;
                transform: translateY(0);
            }

        #chatbot-button {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 60px;
            height: 60px;
            background-color: #4f46e5;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            cursor: pointer;
            box-shadow: 0 6px 15px rgba(0,0,0,0.25);
            z-index: 9999;
            transition: transform 0.2s ease;
        }

            #chatbot-button:hover {
                transform: scale(1.1);
            }

        #chatbot-window {
            position: fixed;
            bottom: 90px;
            right: 20px;
            width: 320px;
            height: 420px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            display: flex;
            flex-direction: column;
            z-index: 9999;
        }

        .hidden {
            display: none;
        }

        .chat-header {
            background: #4f46e5;
            color: white;
            padding: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
        }

        .chat-body {
            flex: 1;
            padding: 10px;
            overflow-y: auto;
            background: #f3f4f6;
        }

        .bot-message {
            background: white;
            padding: 8px 12px;
            border-radius: 10px;
            margin-bottom: 8px;
            max-width: 80%;
        }

        .chat-input {
            display: flex;
            padding: 8px;
            border-top: 1px solid #ddd;
        }

            .chat-input input {
                flex: 1;
                padding: 8px;
                border-radius: 6px;
                border: 1px solid #ccc;
            }

            .chat-input button {
                margin-left: 6px;
                background: #4f46e5;
                color: white;
                border: none;
                padding: 0 14px;
                border-radius: 6px;
                cursor: pointer;
            }

    </style>
</head>
@if (User.Identity.IsAuthenticated)
{
    <!-- Chatbot Button -->
    <div id="chatbot-button">
        🤖
    </div>

    <!-- Chatbot Window -->
    <div id="chatbot-window" class="hidden">
        <div class="chat-header">
            <span>SmartQuiz Assistant</span>
            <button id="close-chat">✖</button>
        </div>

        <div class="chat-body">
            <div class="bot-message">
                👋 Bonjour ! Je suis là pour t’aider.
            </div>
        </div>

        <div class="chat-input">
            <input type="text" placeholder="Écris ton message..." />
            <button>➤</button>
        </div>
    </div>
}




<body>

    <!-- ---------------- TOP PUBLIC NAV ---------------- -->
    <header class="top-horizontal shadow-sm">
        <div class="container d-flex align-items-center justify-content-between py-2">

            <div class="d-flex align-items-center gap-3">

                <!-- LOGO -->
                <a href="/" class="d-flex align-items-center text-decoration-none">
                    <i class="fa-solid fa-graduation-cap fa-2x text-primary me-2"></i>
                    <div class="d-none d-md-block">
                        <div class="fw-bold text-primary">SmartQuiz</div>
                        <small class="text-muted">Plateforme pédagogique</small>
                    </div>
                </a>

                <!-- NAVIGATION -->
                <nav class="d-none d-lg-block">
                    <ul class="nav">

                        <li class="nav-item"><a class="nav-link @(IsActive("Index"))" href="/">Accueil</a></li>

                        <li class="nav-item"><a class="nav-link @(IsActive("Pourquoi"))" href="/Home/Pourquoi">Pourquoi</a></li>

                        <li class="nav-item"><a class="nav-link @(IsActive("Temoignages"))" href="/Home/Temoignages">Témoignages</a></li>

                        <li class="nav-item"><a class="nav-link @(IsActive("CommentCaMarche"))" href="/Home/CommentCaMarche">Comment ça marche</a></li>

                        <li class="nav-item"><a class="nav-link @(IsActive("Galerie"))" href="/Home/Galerie">Galerie</a></li>

                        <li class="nav-item"><a class="nav-link @(IsActive("FAQ"))" href="/Home/FAQ">FAQ</a></li>

                        <li class="nav-item"><a class="nav-link @(IsActive("Technologies"))" href="/Home/Technologies">Technologies</a></li>

                    </ul>
                </nav>

            </div>

            <!-- RIGHT SIDE AUTH -->
            <div class="d-flex align-items-center gap-2">

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <div class="d-none d-md-block text-end me-2">
                        <div class="fw-semibold">@User.Identity?.Name</div>
                        <small class="text-muted">@User.FindFirst(ClaimTypes.Role)?.Value</small>
                    </div>

                    <a href="/Account/Logout" class="btn btn-outline-danger btn-sm">Déconnexion</a>
                }
                else
                {
                    <a href="/Account/Login" class="btn btn-sm btn-primary">Connexion</a>
                    <a href="/Account/Register" class="btn btn-sm btn-outline-primary">Inscription</a>
                }

            </div>
        </div>

    </header>


    <!-- ---------------- MAIN CONTENT ---------------- -->
    <main class="public-main fade-up">
        @RenderBody()
    </main>

    <footer class="text-center text-muted py-4">
        <small>© @DateTime.UtcNow.Year SmartQuiz — Plateforme d'enseignement | <a href="/Home/Privacy">Confidentialité</a></small>
    </footer>

    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Fade animation
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll(".fade-up").forEach((el, i) => {
                setTimeout(() => el.classList.add("show"), 60 * i);
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

@functions {
    public string IsActive(string action)
    {
        return ViewContext.RouteData.Values["action"]?.ToString() == action ? "active" : "";
    }
}
