@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SmartQuiz</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <!-- Bootstrap & FontAwesome (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css" />

    <!-- Your teacher css -->
    <link rel="stylesheet" href="~/css/teacher.css" />

    <style>
        /* small layout overrides / micro animations */
        .nav-badge {
            font-size: .78rem;
            padding: 3px 8px;
            border-radius: 999px;
        }

        .btn-ghost {
            background: transparent;
            border: 1px solid rgba(0,0,0,0.06);
        }

        .table thead th {
            font-weight: 600;
        }

        .fade-up {
            transform: translateY(6px);
            opacity: 0;
            transition: all .35s ease;
        }

            .fade-up.show {
                transform: translateY(0);
                opacity: 1;
            }

        .toolbar .btn {
            transition: transform .12s ease, box-shadow .12s ease;
        }

            .toolbar .btn:hover {
                transform: translateY(-2px);
            }
        /* small responsive fix for long titles */
        .page-title {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 60vw;
            display: inline-block;
            vertical-align: middle;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="brand d-flex align-items-center">
            <i class="fa-solid fa-graduation-cap fa-2x me-2"></i>
            <div>
                <div class="fw-bold">SmartQuiz</div>
                <small style="opacity:0.9">Teacher Panel</small>
            </div>
        </div>

        <nav class="mt-3">
            <a class="d-flex align-items-center @((ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : ""))" href="/Teacher/Index"><i class="fa fa-home me-3"></i><span class="nav-label">Dashboard</span></a>
            <a class="d-flex align-items-center @((ViewContext.RouteData.Values["action"]?.ToString() == "Quizzes" ? "active" : ""))" href="/Teacher/Quizzes"><i class="fa fa-list me-3"></i><span class="nav-label">Mes Quizzes</span></a>
            <a class="d-flex align-items-center @((ViewContext.RouteData.Values["action"]?.ToString() == "Tps" ? "active" : ""))" href="/Teacher/Tps"><i class="fa fa-file-lines me-3"></i><span class="nav-label">Mes TPs</span></a>
            <a class="d-flex align-items-center @((ViewContext.RouteData.Values["action"]?.ToString() == "Groups" ? "active" : ""))" href="/Teacher/Groups"><i class="fa fa-users me-3"></i><span class="nav-label">Groupes</span></a>
            <a class="d-flex align-items-center" href="/Teacher/Results"><i class="fa fa-chart-line me-3"></i><span class="nav-label">Résultats</span></a>
            <li class="nav-item">
                <a class="nav-link" href="/Messages">
                    <i class="fa fa-comments"></i> Messages
                    <span id="unreadBadge" class="badge bg-danger" style="display:none;">0</span>
                </a>
            </li>


            <hr style="border-color: rgba(255,255,255,0.06);" />
            <a class="d-flex align-items-center" href="/Account/Profile"><i class="fa fa-user me-3"></i><span class="nav-label">Profil</span></a>
            <a class="d-flex align-items-center" href="/Account/Logout"><i class="fa fa-right-from-bracket me-3"></i><span class="nav-label">Déconnexion</span></a>
        </nav>
    </div>

    <div class="main">
        <div class="topbar d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <h4 class="m-0 page-title">@ViewData["Title"]</h4>
                <form method="get" class="d-none d-md-block">
                    <input class="form-control form-control-sm search-input" placeholder="Rechercher..." name="q" />
                </form>
            </div>

            <div class="d-flex align-items-center gap-2 toolbar">
                <a class="btn btn-sm btn-primary d-none d-md-inline-flex align-items-center" href="/Teacher/CreateQuiz"><i class="fa fa-plus me-2"></i> Créer</a>

                <div class="dropdown">
                    <a class="d-flex align-items-center gap-2 text-dark text-decoration-none" href="#" data-bs-toggle="dropdown">
                        <div class="avatar"></div>
                        <div class="d-none d-md-block text-end">
                            <div class="fw-semibold">@User.Identity?.Name</div>
                            <small class="text-muted">Teacher</small>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/Account/Profile">Profil</a></li>
                        <li><a class="dropdown-item" href="/Account/Logout">Déconnexion</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <main class="mt-3">
            @RenderBody()
        </main>

        <footer class="mt-5 text-center text-muted">
            <small>© @DateTime.UtcNow.Year SmartQuiz — Plateforme d'enseignement</small>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // simple entrance animation
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.fade-up').forEach(function (el, i) {
                setTimeout(function () { el.classList.add('show'); }, 80 * i);
            });
        });
    </script>
</body>
</html>
