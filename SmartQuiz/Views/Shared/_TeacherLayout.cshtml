<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SmartQuiz</title>

    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="stylesheet" href="~/css/teacher.css" />


    
</head>
<body>
    <div class="sidebar">
        <div class="brand">
            <i class="fa-solid fa-graduation-cap"></i>
            <div>SmartQuiz<br /><small style="opacity:0.85">Teacher Panel</small></div>
        </div>

        <nav>
            <a href="/Teacher/Index"><i class="fa fa-home me-2"></i> Dashboard</a>
            <a href="/Teacher/Quizzes"><i class="fa fa-list me-2"></i> Mes Quizzes</a>
            <a href="/Teacher/Tps"><i class="fa fa-file-lines me-2"></i> Mes TPs</a>
            <a href="/Teacher/Groups"><i class="fa fa-users me-2"></i> Groupes</a>
            <a href="/Teacher/Results"><i class="fa fa-chart-line me-2"></i> Résultats</a>
            <a href="/Teacher/Messages"><i class="fa fa-envelope me-2"></i> Messages</a>
            <hr style="border-color: rgba(255,255,255,0.08);" />
            <a href="/Account/Profile"><i class="fa fa-user me-2"></i> Profil</a>
            <a href="/Account/Logout"><i class="fa fa-right-from-bracket me-2"></i> Déconnexion</a>
        </nav>
    </div>

    <div class="main container-fluid">
        <div class="topbar">
            <div style="display:flex; align-items:center; gap:12px;">
                <h4 style="margin:0;">@ViewData["Title"]</h4>
                <input class="form-control form-control-sm search-input" placeholder="Rechercher..." />
            </div>

            <div style="display:flex; align-items:center; gap:12px;">
                <a class="btn btn-sm btn-primary" href="/Teacher/CreateQuiz"><i class="fa fa-plus"></i> Créer</a>
                <div class="dropdown">
                    <a class="d-flex align-items-center gap-2 text-dark text-decoration-none" href="#" data-bs-toggle="dropdown">
                        <div class="avatar"></div>
                        <strong>@User.Identity.Name</strong>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/Account/Profile">Profil</a></li>
                        <li><a class="dropdown-item" href="/Account/Logout">Déconnexion</a></li>
                    </ul>
                </div>
            </div>
        </div>

        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
