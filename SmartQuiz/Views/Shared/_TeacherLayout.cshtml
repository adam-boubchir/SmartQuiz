@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SmartQuiz</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <!-- Bootstrap & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css" />

    <!-- Teacher CSS -->
    <link rel="stylesheet" href="~/css/teacher.css?v=2" />


    <style>
        .page-title {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 60vw;
            display: inline-block;
            vertical-align: middle;
        }

        .nav-item-custom {
            padding: 10px 18px;
            color: #fff;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: .15s ease;
        }

            .nav-item-custom:hover {
                background: rgba(255,255,255,0.1);
            }

            .nav-item-custom.active {
                background: rgba(255,255,255,0.22);
                font-weight: 600;
            }

        .avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background-color: #d9d9d9;
            background-position: center;
            background-size: cover;
        }
    </style>
</head>


<body>
    <div class="sidebar">
        <div class="brand d-flex align-items-center">
            <i class="fa-solid fa-graduation-cap fa-2x me-2"></i>
            <div>
                <div class="fw-bold">SmartQuiz</div>
                <small style="opacity:0.9">Teacher Panel</small>
            </div>
        </div>

        <nav class="mt-3">

            <a class="nav-item-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
               asp-controller="Teacher" asp-action="Index">
                <i class="fa fa-home"></i> <span>Dashboard</span>
            </a>

            <a class="nav-item-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Quizzes" ? "active" : "")"
               asp-controller="Teacher" asp-action="Quizzes">
                <i class="fa fa-list"></i> <span>Mes Quizzes</span>
            </a>

            <a class="nav-item-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Tps" ? "active" : "")"
               asp-controller="Teacher" asp-action="Tps">
                <i class="fa fa-file-lines"></i> <span>Mes TPs</span>
            </a>

            <a class="nav-item-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Groups" ? "active" : "")"
               asp-controller="Teacher" asp-action="Groups">
                <i class="fa fa-users"></i> <span>Groupes</span>
            </a>

            <a class="nav-item-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "StudentsResults" ? "active" : "")"
               asp-controller="Teacher" asp-action="StudentsResults">
                <i class="fa fa-user-graduate"></i> <span>Étudiants</span>
            </a>

            <a class="nav-item-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Results" ? "active" : "")"
               asp-controller="Teacher" asp-action="Results">
                <i class="fa fa-chart-line"></i> <span>Résultats</span>
            </a>

            <a class="nav-item-custom"
               asp-controller="Messages" asp-action="Index">
                <i class="fa fa-comments"></i>
                <span>Messages</span>
                <span id="unreadBadge" class="badge bg-danger" style="display:none;">0</span>
            </a>

            <hr style="border-color: rgba(255,255,255,0.07)" />

            <a class="nav-item-custom" asp-controller="Account" asp-action="Profile">
                <i class="fa fa-user"></i> <span>Profil</span>
            </a>

            <a class="nav-item-custom" asp-controller="Account" asp-action="Logout">
                <i class="fa fa-right-from-bracket"></i> <span>Déconnexion</span>
            </a>
        </nav>
    </div>


    <div class="main">
        <div class="topbar d-flex align-items-center justify-content-between">
            <h4 class="m-0 page-title">@ViewData["Title"]</h4>

            <div class="d-flex align-items-center gap-3">

                <!-- ⭐ Bouton CRÉER vers la création de quiz -->
                <a class="btn btn-sm btn-primary d-none d-md-inline-flex align-items-center"
                   asp-controller="Teacher" asp-action="CreateQuiz">
                    <i class="fa fa-plus me-2"></i>Créer
                </a>


                <div class="dropdown">
                    <a class="d-flex align-items-center gap-2 text-dark text-decoration-none"
                       data-bs-toggle="dropdown">

                        <div class="avatar"
                             style="background-image:url('@(HttpContextAccessor.HttpContext?.User?.FindFirst("ProfileImage")?.Value ?? "/images/default-avatar.png")');">
                        </div>

                        <div class="d-none d-md-block text-end">
                            <div class="fw-semibold">@User.Identity?.Name</div>
                            <small class="text-muted">Teacher</small>
                        </div>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profil</a></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout">Déconnexion</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <main>
            @RenderBody()
        </main>


        <footer class="mt-5 text-center text-muted">
            <small>© @DateTime.UtcNow.Year SmartQuiz — Plateforme d'enseignement</small>
        </footer>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
